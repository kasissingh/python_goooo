numbers = []

n = int(input("How many integers do you want to enter? "))

for i in range(n):
    num = int(input("Enter integer: "))
    numbers.append(num)

reversed_list = []

for i in range(len(numbers) - 1, -1, -1):
    reversed_list.append(numbers[i])

print("Original list:", numbers)
print("Reversed list:", reversed_list)